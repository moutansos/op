{
  "description": "Forward Claude Code events to op. The plugin only relays hook payloads; op owns provider routing and formatting.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh\"", "async": true, "timeout": 15}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh\"", "async": true, "timeout": 15}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh\"", "async": true, "timeout": 15}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh\"", "async": true, "timeout": 15}]}],
    "Notification": [
      {
        "matcher": "agent_needs_input|agent_completed|elicitation_dialog",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh\"", "async": true, "timeout": 15}]
      }
    ],
    "Stop": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh\"", "async": true, "timeout": 15}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh\"", "async": true, "timeout": 15}]}]
  }
}
