{
  "description": "Forward Claude Code events to oc-notifier. The plugin only relays hook payloads; oc-notifier owns provider routing and formatting.",
  "hooks": {
    "Notification": [
      {
        "matcher": "agent_needs_input|agent_completed|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh"],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh"],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/forward.sh"],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
